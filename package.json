{
  "name": "bomberman-battle-royale",
  "version": "1.0.0",
  "description": "Web-based Multiplayer Bomberman Battle Royale Game",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build": "vite build",
    "start": "tsx src/server/server.ts",
    "test": "node --import tsx --test src/server/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "puppeteer-core": "^25.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
